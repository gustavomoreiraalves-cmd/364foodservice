# A regra "lib/" acima (Python venv) casa por engano com o código-fonte
# de sistema-364-web/lib — mantém essa pasta versionada.
!sistema-364-web/lib/
!sistema-364-web/lib/**

# FastAPI
.pytest_cache/
.coverage
htmlcov/

# Certificados digitais e chaves — NUNCA versionar
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der

# Documentos financeiros e fiscais reais — extratos, faturas, NF-e baixadas.
# Contêm dados bancarios e PII de terceiros; ficam so na maquina/Drive.
docs/extratos/
docs/faturas/
extratos/
*.ofx
*.ofc
*.qfx
*.retorno
*.RET

# Exceção: sistema-364-web/lib/extratos/ contém código de parsing, não dados
!sistema-364-web/lib/extratos/
!sistema-364-web/lib/extratos/**

