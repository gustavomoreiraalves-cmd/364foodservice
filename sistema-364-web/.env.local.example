# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Necessária APENAS para a aba Usuários (criar/excluir usuários).
# Painel Supabase → Project Settings → API Keys → secret key (sb_secret_...).
# NUNCA use prefixo NEXT_PUBLIC_ nesta chave — ela dá acesso total ao banco.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-aqui

PONTO_BIOMETRIA_CHAVE=

# Cifra o certificado digital A1 (.pfx + senha) guardado em certificados_digitais.
# 32 bytes em base64, DIFERENTE da chave de biometria:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave = reenviar todos os certificados na tela Empresas.
CERTIFICADO_CHAVE=

# Cifra o CSC (Código de Segurança do Contribuinte, NFC-e) guardado em
# empresas_emissao_fiscal. 32 bytes em base64, DIFERENTE de CERTIFICADO_CHAVE
# e da chave de biometria:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave = reconfigurar o CSC de cada marca/modelo em /fiscal/emissor.
CSC_ENCRYPTION_KEY=

# Host embutido no QR das etiquetas de recebimento (lib/etiquetas.js →
# urlRastreio). A etiqueta é impressa uma vez e fica colada na embalagem por
# meses — o QR aponta para este host para sempre, então o valor precisa ser
# definitivo (produção), nunca um domínio de preview/teste.
NEXT_PUBLIC_SITE_URL=https://364foodservice.vercel.app

# Importação das vendas do PDV Consumer (scripts/importar-pdv-consumer.mjs).
# Cookie de uma sessão logada em https://connect.consumer.com.br — copie o
# valor inteiro do header "Cookie" (instruções em scripts/IMPORTACAO-PDV.md).
# Expira quando a sessão do painel expira; aí é só copiar de novo.
CONSUMER_CONNECT_COOKIE=
# Dias reprocessados a cada rodada (padrão 3).
PDV_JANELA_DIAS=3
# Intervalo entre requisições ao Connect em ms (padrão 600; aumente se aparecer 429 no log).
PDV_PAUSA_MS=600
