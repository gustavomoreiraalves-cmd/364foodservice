# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Necessária APENAS para a aba Usuários (criar/excluir usuários).
# Painel Supabase → Project Settings → API Keys → secret key (sb_secret_...).
# NUNCA use prefixo NEXT_PUBLIC_ nesta chave — ela dá acesso total ao banco.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-aqui

PONTO_BIOMETRIA_CHAVE=
